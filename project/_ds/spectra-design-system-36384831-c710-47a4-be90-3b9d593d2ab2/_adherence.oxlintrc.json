{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/marketing/**",
              "components/navigation/**",
              "components/primitives/**",
              "components/surfaces/**",
              "ui_kits/spectra-app/**",
              "ui_kits/spectra-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist Mono|Inter|Inter Tight|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist Mono, Inter, Inter Tight, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|destructive|outline)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'destructive' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrowserFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|glow|children|style|className|key|ref|className|style|children)$/]",
        "message": "<BrowserFrame> doesn't accept that prop. Declared props: url, glow, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|icon|iconRight|disabled|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, as, icon, iconRight, disabled, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'solid' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|interactive|topHighlight|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, interactive, topHighlight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:site|app)$/]",
        "message": "<Card> variant must be one of 'site' | 'app'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|ok|warn|bad|accent)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'ok' | 'warn' | 'bad' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|hint|action|size|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, hint, action, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:inline|page)$/]",
        "message": "<EmptyState> size must be one of 'inline' | 'page'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dot|plain|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, dot, plain."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntegrationChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|mark|status|style|key|ref|className|style|children)$/]",
        "message": "<IntegrationChip> doesn't accept that prop. Declared props: name, mark, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntegrationChip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:live|beta|soon)$/]",
        "message": "<IntegrationChip> status must be one of 'live' | 'beta' | 'soon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiBreakdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:aLabel|aValue|bLabel|bValue|key|ref|className|style|children)$/]",
        "message": "<KpiBreakdown> doesn't accept that prop. Declared props: aLabel, aValue, bLabel, bValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|key|ref|className|style|children)$/]",
        "message": "<KpiCell> doesn't accept that prop. Declared props: label, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCell'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:good|watch|bad|muted)$/]",
        "message": "<KpiCell> tone must be one of 'good' | 'watch' | 'bad' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|prefix|suffix|caption|style|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, value, prefix, suffix, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|links|actions|scrolled|style|key|ref|className|style|children)$/]",
        "message": "<NavPill> doesn't accept that prop. Declared props: logo, links, actions, scrolled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|cadence|blurb|points|cta|featured|style|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: name, price, cadence, blurb, points, cta, featured, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|lede|split|center|wide|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: label, title, lede, split, center, wide, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|collapsed|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarNavItem> doesn't accept that prop. Declared props: icon, label, active, collapsed, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|changePercent|width|height|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, changePercent, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|subtitle|trend|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: title, value, subtitle, trend, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|who|message|badge|dim|key|ref|className|style|children)$/]",
        "message": "<TerminalLine> doesn't accept that prop. Declared props: time, who, message, badge, dim."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:verified|reverted|pending)$/]",
        "message": "<TerminalLine> badge must be one of 'verified' | 'reverted' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|loading|onToggle|label|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: on, loading, onToggle, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UserProfileCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|email|avatar|collapsed|onClick|key|ref|className|style|children)$/]",
        "message": "<UserProfileCard> doesn't accept that prop. Declared props: name, email, avatar, collapsed, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerifyBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|key|ref|className|style|children)$/]",
        "message": "<VerifyBadge> doesn't accept that prop. Declared props: state."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerifyBadge'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:verified|reverted|pending)$/]",
        "message": "<VerifyBadge> state must be one of 'verified' | 'reverted' | 'pending'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
